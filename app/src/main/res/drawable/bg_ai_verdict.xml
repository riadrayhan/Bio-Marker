<?xml version="1.0" encoding="utf-8"?>
<!-- AI mood-verdict card: soft warm advice background with an amber stroke
     so the Groq "how was your mood" result stands out as the hero element. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cream_advice_bg" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="@color/cream_stroke" />
</shape>

