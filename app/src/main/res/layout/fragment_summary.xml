<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_muted"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== Header card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sumHeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:text="@string/summary_tab_title" />

                        <TextView
                            android:id="@+id/sumDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:text="—" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sumRunNowBtn"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/summary_run_now"
                        app:icon="@android:drawable/ic_popup_sync"
                        app:iconTint="@color/brand_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sumOverall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@color/verdict_good"
                    android:visibility="gone"
                    android:text="—" />

                <TextView
                    android:id="@+id/sumIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/summary_intro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Empty state ===== -->
        <TextView
            android:id="@+id/sumEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="16dp"
            android:background="@color/surface_card"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:text="@string/summary_no_data" />

        <!-- Hidden — kept only to satisfy old findViewById calls. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sumEditTargetsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/summary_set_targets" />

        <!-- ===== Per-metric cards (built programmatically) ===== -->
        <LinearLayout
            android:id="@+id/sumMetricsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

        <!-- ===== ML insights card removed at user request =====
             Hidden zero-height stubs are kept below only so existing
             findViewById calls in SummaryFragment continue to resolve
             without code churn — they don't render anything. -->
        <TextView
            android:id="@+id/sumMlAnomaly"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/sumMlSuggestion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/sumMlPattern"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="96dp" />
    </LinearLayout>
</ScrollView>

