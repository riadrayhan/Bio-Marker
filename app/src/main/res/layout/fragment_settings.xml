<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <!-- Permissions card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_grant_all"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/permStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="2dp"
                android:paddingBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grantAllBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_grant_all" />
        </LinearLayout>

        <!-- Participant card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_research_section"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/participantIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportCsvBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_export_csv" />
        </LinearLayout>

        <!-- Language card: switches the entire app between English and
             Bangla via AppCompatDelegate.setApplicationLocales(...). The
             choice is persisted by AndroidX itself, so it survives
             restarts and is also reflected in the system per-app
             language picker (Android 13+). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_section"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:paddingBottom="10dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/languageToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/langEnglishBtn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_language_english" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/langBanglaBtn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_language_bangla" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Danger card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/revokeBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_revoke" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
