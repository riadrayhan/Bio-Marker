<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_card"
    android:padding="24dp">

    <TextView
        android:id="@+id/breathTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/breath_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/cream_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/breathSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/breath_subtitle"
        android:textColor="@color/cream_text_muted"
        app:layout_constraintTop_toBottomOf="@id/breathTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/breathCircle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_breath_circle"
        app:layout_constraintTop_toBottomOf="@id/breathSubtitle"
        app:layout_constraintBottom_toTopOf="@id/breathPhase"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/breathPhase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/cream_text"
        android:text="@string/breath_phase_inhale"
        app:layout_constraintBottom_toTopOf="@id/breathCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/breathCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:textSize="36sp"
        android:textColor="@color/cream_text"
        android:text="4"
        app:layout_constraintBottom_toTopOf="@id/breathRound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/breathRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/cream_text_muted"
        app:layout_constraintBottom_toTopOf="@id/breathStop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/breathStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/breath_done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

